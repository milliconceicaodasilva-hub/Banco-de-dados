* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body { background-color: #fcfcfc; color: #333; }

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 5%;
    background: white;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

.logo { font-weight: bold; letter-spacing: 2px; font-size: 1.5rem; }
.logo span { color: #d4a373; }

.nav-links { list-style: none; display: flex; gap: 30px; }
.nav-links a { text-decoration: none; color: #333; font-weight: 500; transition: 0.3s; }
.nav-links a:hover { color: #d4a373; }

.hero {
    height: 60vh;
    background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                url('https://images.unsplash.com/photo-1490481651871-ab68ec25d43d?auto=format&fit=crop&q=80&w=1200');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    text-align: center;
}

.hero h1 { font-size: 3rem; margin-bottom: 10px; }

.btn {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 30px;
    background: #d4a373;
    color: white;
    text-decoration: none;
    border-radius: 5px;
    transition: 0.3s;
}

.container { padding: 50px 5%; }
.section-title { text-align: center; margin-bottom: 40px; font-weight: 300; font-size: 2rem; }

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
}

.product-card {
    background: white;
    padding: 15px;
    text-align: center;
    position: relative;
    transition: transform 0.3s;
}

.product-card:hover { transform: translateY(-5px); }

.product-card img { width: 100%; border-radius: 5px; margin-bottom: 15px; }

.badge {
    position: absolute;
    top: 25px;
    left: 25px;
    background: #333;
    color: white;
    padding: 5px 10px;
    font-size: 0.8rem;
}

.price { color: #d4a373; font-weight: bold; margin: 10px 0; }

.add-cart {
    width: 100%;
    padding: 10px;
    border: 1px solid #333;
    background: transparent;
    cursor: pointer;
    transition: 0.3s;
}

.add-cart:hover { background: #333; color: white; }

footer { text-align: center; padding: 40px; background: #eee; margin-top: 50px; }
